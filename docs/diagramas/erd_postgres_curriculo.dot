digraph ERD {
graph [label="PostgreSQL 0014 · currículo", labelloc=t, fontsize=22, fontname="DejaVu Sans", rankdir=TB, splines=polyline, nodesep=0.55, ranksep=0.75, pad=0.25, bgcolor="white"];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#68788c", arrowsize=0.7, penwidth=1.25];
"facultades" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#315a8d" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf1fc"><FONT COLOR="#315a8d" POINT-SIZE="15"><B>facultades</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> codigo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> nombre</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> activo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">boolean</FONT></TD></TR></TABLE>>];
"carreras" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#315a8d" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf1fc"><FONT COLOR="#315a8d" POINT-SIZE="15"><B>carreras</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK facultad_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> codigo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> nombre</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> activo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">boolean</FONT></TD></TR></TABLE>>];
"planes_estudio" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#315a8d" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf1fc"><FONT COLOR="#315a8d" POINT-SIZE="15"><B>planes_estudio</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK carrera_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> codigo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> modalidad</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> estado</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR></TABLE>>];
"unidades_plan" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#315a8d" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf1fc"><FONT COLOR="#315a8d" POINT-SIZE="15"><B>unidades_plan</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK plan_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> numero</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> nombre</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR></TABLE>>];
"carreras" -> "facultades" [arrowhead="vee"];
"planes_estudio" -> "carreras" [arrowhead="vee"];
"unidades_plan" -> "planes_estudio" [arrowhead="vee"];
}
