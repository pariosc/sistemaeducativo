digraph ERD {
graph [label="PostgreSQL 0014 · grupos y planes por periodo", labelloc=t, fontsize=22, fontname="DejaVu Sans", rankdir=TB, splines=polyline, nodesep=0.55, ranksep=0.75, pad=0.25, bgcolor="white"];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#68788c", arrowsize=0.7, penwidth=1.25];
"periodos_carreras" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#315a8d" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf1fc"><FONT COLOR="#315a8d" POINT-SIZE="15"><B>periodos_carreras</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK/FK periodo_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK/FK carrera_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR></TABLE>>];
"periodos_planes" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#315a8d" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf1fc"><FONT COLOR="#315a8d" POINT-SIZE="15"><B>periodos_planes</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK/FK periodo_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK/FK plan_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR></TABLE>>];
"aperturas_plan" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#315a8d" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf1fc"><FONT COLOR="#315a8d" POINT-SIZE="15"><B>aperturas_plan</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK plan_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK periodo_inicio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK carrera_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> codigo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR></TABLE>>];
"semestres_grupo" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#315a8d" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf1fc"><FONT COLOR="#315a8d" POINT-SIZE="15"><B>semestres_grupo</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK/FK apertura_plan_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK numero</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK periodo_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR></TABLE>>];
"carreras" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9aa8b5" BGCOLOR="#f5f7f9" CELLPADDING="6"><TR><TD><FONT POINT-SIZE="13">carreras ↗</FONT></TD></TR></TABLE>>, style=dashed];
"periodos_academicos" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9aa8b5" BGCOLOR="#f5f7f9" CELLPADDING="6"><TR><TD><FONT POINT-SIZE="13">periodos_academicos ↗</FONT></TD></TR></TABLE>>, style=dashed];
"planes_estudio" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9aa8b5" BGCOLOR="#f5f7f9" CELLPADDING="6"><TR><TD><FONT POINT-SIZE="13">planes_estudio ↗</FONT></TD></TR></TABLE>>, style=dashed];
"aperturas_plan" -> "periodos_academicos" [arrowhead="vee", style=dashed];
"aperturas_plan" -> "planes_estudio" [arrowhead="vee", label="(plan_id, carrera_id)", fontsize=10, style=dashed];
"periodos_carreras" -> "carreras" [arrowhead="vee", style=dashed];
"periodos_carreras" -> "periodos_academicos" [arrowhead="vee", style=dashed];
"periodos_planes" -> "periodos_academicos" [arrowhead="vee", style=dashed];
"periodos_planes" -> "planes_estudio" [arrowhead="vee", style=dashed];
"semestres_grupo" -> "aperturas_plan" [arrowhead="vee"];
"semestres_grupo" -> "periodos_academicos" [arrowhead="vee", style=dashed];
}
