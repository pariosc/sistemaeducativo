digraph ERD {
graph [label="PostgreSQL 0014 · materias y prerrequisitos", labelloc=t, fontsize=22, fontname="DejaVu Sans", rankdir=TB, splines=polyline, nodesep=0.55, ranksep=0.75, pad=0.25, bgcolor="white"];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#68788c", arrowsize=0.7, penwidth=1.25];
"materias" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#315a8d" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf1fc"><FONT COLOR="#315a8d" POINT-SIZE="15"><B>materias</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> codigo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> nombre</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> activo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">boolean</FONT></TD></TR></TABLE>>];
"materias_plan" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#315a8d" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf1fc"><FONT COLOR="#315a8d" POINT-SIZE="15"><B>materias_plan</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK plan_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK unidad_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK materia_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR></TABLE>>];
"prerrequisitos_materia_plan" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#315a8d" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf1fc"><FONT COLOR="#315a8d" POINT-SIZE="15"><B>prerrequisitos_materia_plan</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK/FK plan_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK/FK materia_plan_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK/FK requisito_materia_plan_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR></TABLE>>];
"planes_estudio" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9aa8b5" BGCOLOR="#f5f7f9" CELLPADDING="6"><TR><TD><FONT POINT-SIZE="13">planes_estudio ↗</FONT></TD></TR></TABLE>>, style=dashed];
"unidades_plan" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9aa8b5" BGCOLOR="#f5f7f9" CELLPADDING="6"><TR><TD><FONT POINT-SIZE="13">unidades_plan ↗</FONT></TD></TR></TABLE>>, style=dashed];
"materias_plan" -> "unidades_plan" [arrowhead="vee", label="(plan_id, unidad_id)", fontsize=10, style=dashed];
"materias_plan" -> "materias" [arrowhead="vee"];
"materias_plan" -> "planes_estudio" [arrowhead="vee", style=dashed];
"prerrequisitos_materia_plan" -> "materias_plan" [arrowhead="vee", label="(plan_id, materia_plan_id)", fontsize=10];
"prerrequisitos_materia_plan" -> "materias_plan" [arrowhead="vee", label="(plan_id, requisito_materia_plan_id)", fontsize=10];
}
