digraph ERD {
graph [label="PostgreSQL 0014 · usuarios y sesiones", labelloc=t, fontsize=22, fontname="DejaVu Sans", rankdir=TB, splines=polyline, nodesep=0.55, ranksep=0.75, pad=0.25, bgcolor="white"];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#68788c", arrowsize=0.7, penwidth=1.25];
"usuarios" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#72519c" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#f3edfc"><FONT COLOR="#72519c" POINT-SIZE="15"><B>usuarios</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> ci</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> nombres</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> apellidos</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#6e7a88">+8 atributos</FONT></TD></TR></TABLE>>];
"perfiles_docente" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#72519c" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#f3edfc"><FONT COLOR="#72519c" POINT-SIZE="15"><B>perfiles_docente</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK/FK usuario_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR></TABLE>>];
"perfiles_estudiante" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#72519c" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#f3edfc"><FONT COLOR="#72519c" POINT-SIZE="15"><B>perfiles_estudiante</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK/FK usuario_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK plan_estudio_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK apertura_plan_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR></TABLE>>];
"sesiones_autenticacion" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#72519c" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#f3edfc"><FONT COLOR="#72519c" POINT-SIZE="15"><B>sesiones_autenticacion</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK usuario_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> token_hash</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> fecha_inicio</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> fecha_expiracion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">timestamptz</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#6e7a88">+1 atributos</FONT></TD></TR></TABLE>>];
"aperturas_plan" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9aa8b5" BGCOLOR="#f5f7f9" CELLPADDING="6"><TR><TD><FONT POINT-SIZE="13">aperturas_plan ↗</FONT></TD></TR></TABLE>>, style=dashed];
"planes_estudio" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9aa8b5" BGCOLOR="#f5f7f9" CELLPADDING="6"><TR><TD><FONT POINT-SIZE="13">planes_estudio ↗</FONT></TD></TR></TABLE>>, style=dashed];
"perfiles_docente" -> "usuarios" [arrowhead="vee"];
"perfiles_estudiante" -> "aperturas_plan" [arrowhead="vee", style=dashed];
"perfiles_estudiante" -> "planes_estudio" [arrowhead="vee", style=dashed];
"perfiles_estudiante" -> "usuarios" [arrowhead="vee"];
"sesiones_autenticacion" -> "usuarios" [arrowhead="vee"];
}
