digraph ERD {
graph [label="PostgreSQL 0014 · periodos y calendario", labelloc=t, fontsize=22, fontname="DejaVu Sans", rankdir=TB, splines=polyline, nodesep=0.55, ranksep=0.75, pad=0.25, bgcolor="white"];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#68788c", arrowsize=0.7, penwidth=1.25];
"periodos_academicos" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2d7d53" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf7ee"><FONT COLOR="#2d7d53" POINT-SIZE="15"><B>periodos_academicos</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK plantilla_modular_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> denominacion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> fecha_inicio</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> fecha_fin</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">date</FONT></TD></TR></TABLE>>];
"plantillas_modulares" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2d7d53" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf7ee"><FONT COLOR="#2d7d53" POINT-SIZE="15"><B>plantillas_modulares</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> nombre</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> clases_por_modulo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> minutos_por_clase</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">integer</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#6e7a88">+1 atributos</FONT></TD></TR></TABLE>>];
"bloques_horario" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2d7d53" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf7ee"><FONT COLOR="#2d7d53" POINT-SIZE="15"><B>bloques_horario</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> turno</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> nombre</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> hora_inicio</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">time without…</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#6e7a88">+3 atributos</FONT></TD></TR></TABLE>>];
"feriados_periodo" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2d7d53" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf7ee"><FONT COLOR="#2d7d53" POINT-SIZE="15"><B>feriados_periodo</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK periodo_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> fecha</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> descripcion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR></TABLE>>];
"feriados_periodo" -> "periodos_academicos" [arrowhead="vee"];
"periodos_academicos" -> "plantillas_modulares" [arrowhead="vee"];
}
