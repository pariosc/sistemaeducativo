"perfiles_docente" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9aa8b5" BGCOLOR="#f5f7f9" CELLPADDING="6"><TR><TD><FONT POINT-SIZE="13">perfiles_docente ↗</FONT></TD></TR></TABLE>>, style=dashed];
