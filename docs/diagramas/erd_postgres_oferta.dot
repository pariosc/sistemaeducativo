digraph ERD {
graph [label="PostgreSQL 0014 · paralelos y aulas", labelloc=t, fontsize=22, fontname="DejaVu Sans", rankdir=TB, splines=polyline, nodesep=0.55, ranksep=0.75, pad=0.25, bgcolor="white"];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#68788c", arrowsize=0.7, penwidth=1.25];
"aulas" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2d7d53" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf7ee"><FONT COLOR="#2d7d53" POINT-SIZE="15"><B>aulas</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK codigo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> activa</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> capacidad</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">integer</FONT></TD></TR></TABLE>>];
"cursos" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2d7d53" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf7ee"><FONT COLOR="#2d7d53" POINT-SIZE="15"><B>cursos</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK materia_plan_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK periodo_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK docente_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK apertura_plan_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK plantilla_modular_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> paralelo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> cupo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> fecha_inicio</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">date</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#6e7a88">+5 atributos</FONT></TD></TR></TABLE>>];
