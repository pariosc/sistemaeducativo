"excepciones_horario" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#2d7d53" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#eaf7ee"><FONT COLOR="#2d7d53" POINT-SIZE="15"><B>excepciones_horario</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK curso_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK aula</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> fecha_original</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> tipo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> fecha_reprogramada</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">date</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#6e7a88">+3 atributos</FONT></TD></TR></TABLE>>];
