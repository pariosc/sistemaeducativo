digraph ERD {
graph [label="PostgreSQL 0014 · inscripciones, notas y avisos", labelloc=t, fontsize=22, fontname="DejaVu Sans", rankdir=TB, splines=polyline, nodesep=0.55, ranksep=0.75, pad=0.25, bgcolor="white"];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#68788c", arrowsize=0.7, penwidth=1.25];
"habilitaciones_inscripcion" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#72519c" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#f3edfc"><FONT COLOR="#72519c" POINT-SIZE="15"><B>habilitaciones_inscripcion</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK estudiante_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK periodo_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK autorizada_por_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> activa</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> origen</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> fecha_autorizacion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">timestamptz</FONT></TD></TR></TABLE>>];
"inscripciones" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#72519c" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#f3edfc"><FONT COLOR="#72519c" POINT-SIZE="15"><B>inscripciones</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK estudiante_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK curso_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> fecha_inscripcion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> estado</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR></TABLE>>];
"calificaciones" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#72519c" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#f3edfc"><FONT COLOR="#72519c" POINT-SIZE="15"><B>calificaciones</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK inscripcion_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> nota_final</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> fecha_registro</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">timestamptz</FONT></TD></TR></TABLE>>];
"notificaciones" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#72519c" BGCOLOR="white" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#f3edfc"><FONT COLOR="#72519c" POINT-SIZE="15"><B>notificaciones</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK destinatario_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">FK curso_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> tipo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> titulo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"> mensaje</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#526174">varchar</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#6e7a88">+2 atributos</FONT></TD></TR></TABLE>>];
"cursos" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9aa8b5" BGCOLOR="#f5f7f9" CELLPADDING="6"><TR><TD><FONT POINT-SIZE="13">cursos ↗</FONT></TD></TR></TABLE>>, style=dashed];
"perfiles_estudiante" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9aa8b5" BGCOLOR="#f5f7f9" CELLPADDING="6"><TR><TD><FONT POINT-SIZE="13">perfiles_estudiante ↗</FONT></TD></TR></TABLE>>, style=dashed];
"periodos_academicos" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9aa8b5" BGCOLOR="#f5f7f9" CELLPADDING="6"><TR><TD><FONT POINT-SIZE="13">periodos_academicos ↗</FONT></TD></TR></TABLE>>, style=dashed];
"usuarios" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9aa8b5" BGCOLOR="#f5f7f9" CELLPADDING="6"><TR><TD><FONT POINT-SIZE="13">usuarios ↗</FONT></TD></TR></TABLE>>, style=dashed];
"calificaciones" -> "inscripciones" [arrowhead="vee"];
"habilitaciones_inscripcion" -> "usuarios" [arrowhead="vee", style=dashed];
"habilitaciones_inscripcion" -> "perfiles_estudiante" [arrowhead="vee", style=dashed];
"habilitaciones_inscripcion" -> "periodos_academicos" [arrowhead="vee", style=dashed];
"inscripciones" -> "cursos" [arrowhead="vee", style=dashed];
"inscripciones" -> "perfiles_estudiante" [arrowhead="vee", style=dashed];
"notificaciones" -> "cursos" [arrowhead="vee", style=dashed];
"notificaciones" -> "usuarios" [arrowhead="vee", style=dashed];
}
